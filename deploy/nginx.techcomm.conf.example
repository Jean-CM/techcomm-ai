# Example Nginx reverse proxy for Techcomm Operations.
# Terminate TLS with your organization's certificate management process.

limit_req_zone $binary_remote_addr zone=techcomm_general:10m rate=20r/s;

server {
    listen 80;
    server_name operations.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name operations.example.com;

    ssl_certificate     /etc/ssl/certs/operations.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/operations.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    client_max_body_size 10m;

    location / {
        limit_req zone=techcomm_general burst=40 nodelay;

        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        proxy_connect_timeout 10s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }
}
