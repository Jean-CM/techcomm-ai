# -----------------------------------------------------------------------------
# Techcomm Operations environment template
# Copy to .env.production on the server. Never commit real values.
# -----------------------------------------------------------------------------

# Public browser variables (safe to expose, but still environment-specific)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Core server-only variables
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
TECHCOMM_TOOL_SECRET=
CRON_SECRET=

# ElevenLabs / voice / WhatsApp
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_REMINDER_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
TECHNICIAN_ASSIGNMENT_TEMPLATE_NAME=techcomm_asignacion_tecnico
CUSTOMER_QUOTE_TEMPLATE_NAME=techcomm_cotizacion_cliente

# Quotation email delivery (server-only)
# Use a verified sender/domain. Never expose the API key to the browser.
RESEND_API_KEY=
QUOTE_EMAIL_FROM=

# Twilio signature validation (only required where Twilio webhooks are enabled)
TWILIO_AUTH_TOKEN=

# Optional / future integrations already referenced by the wider platform
DATABASE_URL=
SENTRY_AUTH_TOKEN=
BETTER_STACK_SOURCE_TOKEN=
N8N_WEBHOOK_SECRET=
APP_ENCRYPTION_KEY=
INTERNAL_API_SECRET=
